/*
 * Description: This module specifies the Secure Hash Algorithm with a
 * digest size of 512 bits (SHA-512) [FIPS-PUB-180-4 Section 6.4].
 */
module algorithms::SHA2::SHA512 = packaging::Hash where

type _BlockSize  = 1024
type _DigestSize = 512
type _UpperLimit = 128

import algorithms::SHA2::Notation (ROTR, SHR)
import algorithms::SHA2::Preprocessing (H0_512)
import algorithms::SHA2::Functions ( SIGMA_512_0
                                   , SIGMA_512_1
                                   , sigma_512_0
                                   , sigma_512_1
                                   , K_512)

import algorithms::SHA2::Main as SHA512 where
  type d = 512
  type w = 64
  type Klen = 80

  H0 = H0_512
  K = K_512

  SIGMA_0 = SIGMA_512_0
  SIGMA_1 = SIGMA_512_1
  sigma_0 = sigma_512_0
  sigma_1 = sigma_512_1

_hash = SHA512::hash