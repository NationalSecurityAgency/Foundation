/*
 * Description: This module specifies the Secure Hash Algorithm with a
 * digest size of 256 bits (SHA-256) [FIPS-PUB-180-4 Section 6.2].
 */
module algorithms::SHA2::SHA256 = packaging::Hash where

type _BlockSize  = 512
type _DigestSize = 256
type _UpperLimit = 64

import algorithms::SHA2::Notation (ROTR, SHR)
import algorithms::SHA2::Preprocessing (H0_256)
import algorithms::SHA2::Functions ( SIGMA_256_0
                                   , SIGMA_256_1
                                   , sigma_256_0
                                   , sigma_256_1
                                   , K_256)

import algorithms::SHA2::Main as SHA256 where
  type d = 256
  type w = 32
  type Klen = 64

  H0 = H0_256
  K = K_256

  SIGMA_0 = SIGMA_256_0
  SIGMA_1 = SIGMA_256_1
  sigma_0 = sigma_256_0
  sigma_1 = sigma_256_1

_hash = SHA256::hash