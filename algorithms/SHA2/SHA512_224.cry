/*
 * Description: This module specifies the Secure Hash Algorithm with a
 * variant of SHA-512 with a digest size of 224 bits (SHA-512/224)
 * [FIPS-PUB-180-4 Section 6.6].
 */
module algorithms::SHA2::SHA512_224 = packaging::Hash where

type _BlockSize  = 1024
type _DigestSize = 224
type _UpperLimit = 128

import algorithms::SHA2::Notation (ROTR, SHR)
import algorithms::SHA2::Preprocessing (H0_512_224)
import algorithms::SHA2::Functions ( SIGMA_512_0
                                   , SIGMA_512_1
                                   , sigma_512_0
                                   , sigma_512_1
                                   , K_512)

import algorithms::SHA2::Main as SHA512_224 where
  type d = 224
  type w = 64
  type Klen = 80

  H0 = H0_512_224
  K = K_512

  SIGMA_0 = SIGMA_512_0
  SIGMA_1 = SIGMA_512_1
  sigma_0 = sigma_512_0
  sigma_1 = sigma_512_1

_hash = SHA512_224::hash