/*
 * Description: This module provides cSHAKE128 tests
 * [cSHAKE Examples].
 */

module algorithms::cSHAKE::tests::cSHAKE128 where

import algorithms::cSHAKE::Main (cSHAKE128)

/*
 * The following properties test cSHAKE128 on the sample values
 * provided by [cSHAKE Examples]. Property names give the sample
 * number used there.
 */

property Sample1 = cSHAKE128`{256} X N S == out
  where
    X   = 0x00010203
    N   = []
    S   = join "Email Signature"
    out = join [ 0xc1c36925, 0xb6409a04, 0xf1b504fc, 0xbca9d82b
               , 0x4017277c, 0xb5ed2b20, 0x65fc1d38, 0x14d5aaf5
               ]

property Sample2 = cSHAKE128`{256} X N S == out
  where
    X   = join [ 0x00010203, 0x04050607, 0x08090a0b, 0x0c0d0e0f
               , 0x10111213, 0x14151617, 0x18191a1b, 0x1c1d1e1f
               , 0x20212223, 0x24252627, 0x28292a2b, 0x2c2d2e2f
               , 0x30313233, 0x34353637, 0x38393a3b, 0x3c3d3e3f
               , 0x40414243, 0x44454647, 0x48494a4b, 0x4c4d4e4f
               , 0x50515253, 0x54555657, 0x58595a5b, 0x5c5d5e5f
               , 0x60616263, 0x64656667, 0x68696a6b, 0x6c6d6e6f
               , 0x70717273, 0x74757677, 0x78797a7b, 0x7c7d7e7f
               , 0x80818283, 0x84858687, 0x88898a8b, 0x8c8d8e8f
               , 0x90919293, 0x94959697, 0x98999a9b, 0x9c9d9e9f
               , 0xa0a1a2a3, 0xa4a5a6a7, 0xa8a9aaab, 0xacadaeaf
               , 0xb0b1b2b3, 0xb4b5b6b7, 0xb8b9babb, 0xbcbdbebf
               , 0xc0c1c2c3, 0xc4c5c6c7
               ]
    N   = []
    S   = join "Email Signature"
    out = join [ 0xc5221d50, 0xe4f822d9, 0x6a2e8881, 0xa961420f
               , 0x294b7b24, 0xfe3d2094, 0xbaed2c65, 0x24cc166b
               ]
