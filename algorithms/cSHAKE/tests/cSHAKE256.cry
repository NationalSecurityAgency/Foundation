/*
 * Description: This module provides cSHAKE256 tests
 * [cSHAKE Examples].
 */

module algorithms::cSHAKE::tests::cSHAKE256 where

import algorithms::cSHAKE::Main (cSHAKE256)

/*
 * The following properties test cSHAKE256 on the sample values
 * provided by [cSHAKE Examples]. Property names give the sample
 * number used there.
 */

property Sample3 = cSHAKE256`{512} X N S == out
  where
    X   = 0x00010203
    N   = []
    S   = join "Email Signature"
    out = join [ 0xd008828e, 0x2b80ac9d, 0x2218ffee, 0x1d070c48
               , 0xb8e4c87b, 0xff32c969, 0x9d5b6896, 0xeee0edd1
               , 0x64020e2b, 0xe0560858, 0xd9c00c03, 0x7e34a969
               , 0x37c561a7, 0x4c412bb4, 0xc7464695, 0x27281c8c
               ]

property Sample4 = cSHAKE256`{512} X N S == out
  where
    X   = join [ 0x00010203, 0x04050607, 0x08090a0b, 0x0c0d0e0f
               , 0x10111213, 0x14151617, 0x18191a1b, 0x1c1d1e1f
               , 0x20212223, 0x24252627, 0x28292a2b, 0x2c2d2e2f
               , 0x30313233, 0x34353637, 0x38393a3b, 0x3c3d3e3f
               , 0x40414243, 0x44454647, 0x48494a4b, 0x4c4d4e4f
               , 0x50515253, 0x54555657, 0x58595a5b, 0x5c5d5e5f
               , 0x60616263, 0x64656667, 0x68696a6b, 0x6c6d6e6f
               , 0x70717273, 0x74757677, 0x78797a7b, 0x7c7d7e7f
               , 0x80818283, 0x84858687, 0x88898a8b, 0x8c8d8e8f
               , 0x90919293, 0x94959697, 0x98999a9b, 0x9c9d9e9f
               , 0xa0a1a2a3, 0xa4a5a6a7, 0xa8a9aaab, 0xacadaeaf
               , 0xb0b1b2b3, 0xb4b5b6b7, 0xb8b9babb, 0xbcbdbebf
               , 0xc0c1c2c3, 0xc4c5c6c7
               ]
    N   = []
    S   = join "Email Signature"
    out = join [ 0x07dc27b1, 0x1e51fbac, 0x75bc7b3c, 0x1d983e8b
               , 0x4b85fb1d, 0xefaf2189, 0x12ac8643, 0x02730917
               , 0x27f42b17, 0xed1df63e, 0x8ec118f0, 0x4b23633c
               , 0x1dfb1574, 0xc8fb55cb, 0x45da8e25, 0xafb092bb
               ]
