/*
 * This is a SAW script that guides SAW to prove the properties found
 * in `algorithms/AES/Main.cry`.
 */

// Include common SAW utilities.
include "../../../shared/SAW/utils.saw";

// Include theorems from `Cipher` for use as lemmas.
include "Cipher.saw";

// Import the Cryptol specification for AES's `Encrypt` and `Decrypt`
// routines.
import "../Main.cry";
import "../Types.cry";

// This helper lemma rewrites away the `split (join ...)` between
// `decrypt` and `encrypt` in the `encryptInverts` proof goal.
let verify_split_join : TopLevel Theorem =
   proveit {{ \(xs : Block) -> split (join xs) == xs }} rme;

// This parameterized lemma will be proven at all 3 key sizes (128,
// 192, and 256).

let verify_EncryptInverts (keySize : Int) : TopLevel Theorem =
  do {
    split_join_lemma <- verify_split_join;
    CipherInverts_lemma_keySize <- verify_CipherInverts keySize;

    proveit {{ EncryptInverts`{keySize} }}
      do {
        goal_normalize [ "split", "join", "InvCipher", "Cipher" ];
        print_goal;
        use_lemmas [ split_join_lemma, CipherInverts_lemma_keySize ];
        print_goal;
        goal_eval; trivial;
      };
  };

/*
 * Verify public properties of `algorithms::AES::Main`.
 */
let main : TopLevel [Theorem] = do {
  EncryptInverts_lemmas <- for [128, 192, 256] verify_EncryptInverts;

  summarize_verification;

  return EncryptInverts_lemmas;
};
