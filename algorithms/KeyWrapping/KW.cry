/*
 * Description: This is a Cryptol specification for the KW-AE and KW-AD
 * functions [NIST-800-38F].
 */
module algorithms::KeyWrapping::KW where

import algorithms::KeyWrapping::W64
import shared::common::utils::Enum (unwrap)

// [NIST-800-38F Section 4.3] Variables

ICV1 = 0xA6A6A6A6A6A6A6A6 : [64]

// [NIST-800-38F Section 6.2] KW

/**
 * KW-AE (Algorithm 3) specifies the authenticated-encryption function
 * for KW for a given block cipher and KEK. The wrapping function, W,
 * is invoked in Step 3 with the same block cipher and KEK as
 * prerequisites.
 */
KWAE :
    { n }
    ( fin n, 2 <= n, n < 2^^54 - 1 )
 => ([128] -> [128]) -> [n * 64] -> [(n + 1) * 64]
KWAE CIPHk P = C
  where
    S = ICV1 # P
    C = W`{n+1} CIPHk S

/**
 * KW-AD (Algorithm 4) specifies the authenticated-decryption function
 * for KW for a given block cipher and KEK. The unwrapping function,
 * W', is invoked in Step 4 with the same block cipher and KEK as
 * prerequisites.
 */
KWAD :
    { n }
    ( fin n, 2 <= n, n < 2^^54 - 1 )
 => ([128] -> [128]) -> [(n + 1) * 64] -> Result [n * 64] (String _)
KWAD CIPHk' C =
    if MSB S != ICV1 then Err "FAIL" else Ok P
  where
    S = W'`{n+1} CIPHk' C
    P = LSB S

/**
 * This property demonstrates that `KWAD` inverts `KWAE`.
 *
 * ```
 * :s prover=w4-yices
 * :prove \(P : [2 * 64]) -> KWADInvertsKWAE (\x -> x + 1) (\x -> x - 1) P
 * :prove \(P : [3 * 64]) -> KWADInvertsKWAE (\x -> x + 1) (\x -> x - 1) P
 * :prove \(P : [10 * 64]) -> KWADInvertsKWAE (\x -> x + 1) (\x -> x - 1) P
 * ```
 */
KWADInvertsKWAE :
    { n }
    ( fin n, 2 <= n, n < 2^^54 - 1 )
 => ([128] -> [128]) -> ([128] -> [128]) -> [n * 64] -> Bool
property KWADInvertsKWAE CIPHk CIPHk' P =
    unwrap (KWAD CIPHk' (KWAE CIPHk P)) == P
