/*
 * Description: This module is a Cryptol specification for the Step
 * Mapping algorithms as specified by [FIPS-PUB-202 Section 3.2].
 */

module algorithms::Keccak::StepMappings where

import algorithms::Keccak::Types as Types
import algorithms::Keccak::StateConversions
import shared::LFSR::Main as LFSR
import shared::common::utils::BitVector (parity)

/**
 * The following defines "⨁" as an infix operator for the XOR
 * operation and is used to match the formatting of [FIPS-PUB-202] as
 * closely as possible.
 */
(⨁) = (^)
infixl 45 ⨁

/**
 * [FIPS-PUB-202 Algorithm 1]
 * 1. For all pairs (x,z) such that 0≤x<5 and 0≤z<w, let
 * C[x,z]=A[x,0,z] ⨁ A[x,1,z] ⨁ A[x,2,z] ⨁ A[x,3,z] ⨁ A[x,4,z].
 *
 * 2. For all pairs (x,z) such that 0≤x<5 and 0≤z<w, let
 * D[x,z] = C[(x-1) mod 5, z] ⨁ C[(x+1) mod 5, (z-1) mod w].
 *
 * 3. For all triples (x,y,z) such that 0≤x<5, 0≤y<5, and 0≤z<w, let
 * A'[x,y,z] = A[x,y,z] ⨁ D[x,z].
 */
θ : {w} (fin w) => Types::State w -> Types::State w 
θ A = A'
  where
    C, D : [5][w]
    C@x    = A@x@0 ⨁ A@x@1 ⨁ A@x@2 ⨁ A@x@3 ⨁ A@x@4 
    D@x    = C@((x-1) % 5) ⨁ C@((x+1) % 5) >>> 1
    A'@x@y = A@x@y ⨁ D@x

/**
 * [FIPS-PUB-202 Algorithm 2]
 * 1. For all z such that 0≤z<w, let A'[0,0,z] = A[0,0,z].
 * 2. Let (x,y) = (1,0).
 * 3. For t from 0 to 23:
 *   a. for all z such that 0≤z<w, let A'[x,y,z]=A[x,y,(z-(t+1)(t+2)/2 mod w]
 *   b. let (x,y) = (y,(2x+3y) mod 5).
 *
 * Here we specify the offset table variant.
 */
ρ : {w} (fin w) => Types::State w -> Types::State w
ρ A = A' 
  where
    A'      = groupBy`{5} [ a >>> o | a <- join A | o <- offsets ]
    offsets = [   0,  36,   3, 105, 210
              ,   1, 300,  10,  45,  66
              , 190,   6, 171,  15, 253
              ,  28,  55, 153,  21, 120
              ,  91, 276, 231, 136,  78
              ]

/**
 * [FIPS-PUB-202 Algorithm 3]
 * For all triples (x,y,z) such that 0≤x<5, 0≤y<5, 0≤z<w, let
 * A'[x,y,z] = A[(x+3y) mod 5, x, z]
 */
π : {w} (fin w) => Types::State w -> Types::State w
π A = A'
  where
    A'@x@y = A@((x + 3 * y) % 5)@x 

/**
 * [FIPS-PUB-202 Algorithm 4]
 * For all triples (x,y,z) such that 0≤x<5, 0≤y<5, 0≤z<w, let
 * A'[x,y,z] = A[x,y,z] ⨁ ((A[(x+1) mod 5, y, z] ⨁ 1) ⦁ A[(x+2) mod 5, y, z]). 
 */
χ : {w} (fin w) => Types::State w -> Types::State w
χ A = A' 
  where 
    A'@x = A@x ⨁ ~A@((x+1) % 5) && A@((x+2) % 5)

/**
 * [FIPS-PUB-202 Algorithm 5]
 * The specification of ι's round constant `rc`. Each of these l + 1
 * bits is generated by a function that is based on a linear feedback
 * shift register. Note, l = log2(w).
 */
rc : [inf]
rc = (LFSR::fmsrRun (⨁) <| x^^8 + x^^6 + x^^5 + x^^4 + 1 |> 0b10000000).stream 

/**
 * [FIPS-PUB-202 Algorithm 6]
 * For all triples (x,y,z) such that 0≤x<5, 0≤y<5, 0≤z<w, let
 * A'[0,0,z]=A'[0,0,z] ⨁ RC[z].
 * Otherwise,
 * A'[x,y,z] = A[x,y,z].
 * The round constant bits for `ir` are excited by
 * RC[2^^j - 1] = rc(j+7*ir)
 */
ι :
    {w, a}
    (fin w, Integral a, Literal (max 7 (lg2 w)) a)
 => Types::State w -> a -> Types::State w
ι A ir = A' 
  where 
    type l = lg2 w // [FIPS-PUB-202 Section 2.2]
    A'@x@y = if (x == 0 /\ y == 0) then A@x@y ⨁ RC else A@x@y
    RC = updates zero
           [        2^^j - 1 | j <- [0 .. l] ]
           [ rc @ (j + 7*ir) | j <- [0 .. l] ]

/**
 * The Keccak Round Function, `Rnd`, is the transformation that
 * results from applying the step functions in order [FIPS-PUB-202
 * part of Algorithm 7].
 */
Rnd :
    {w, a}
    (fin w, Integral a, Literal (max 7 (lg2 w)) a)
 => Types::State w -> a -> Types::State w 
Rnd A ir = ι (χ (π (ρ (θ A)))) ir

/**
 * [FIPS-PUB-202 Algorithm 7]
 * 1. Converts `S` into a state array, `A`, as described in Section 3.1.2.
 * 2. For `ir` from `12+2l-nr` to `12+2l-1`, let `A = Rnd(A, ir)`.
 * 3. Convert `A` into a string `S'` of length `b`, as described in Section 3.1.3.
 * 4. Return `S'`.
 */
Keccak_p :
    { w, nr }
    ( fin w
    , fin nr
    , 12 + 2 * (lg2 w) >= nr
    )
 => Types::String w -> Types::String w
Keccak_p S = S' 
  where
    type l = lg2 w 
    A      = toState S 
    A'     = foldl Rnd A [12 + 2*l - nr .. < 12 + 2*l]
    S'     = toString A' 

/**
 * A Rust FFI for Keccak_p specialized to `w = 64` and `nr = 24`.
 */
foreign Keccak_p_FFI : Types::State 64 -> Types::State 64
Keccak_p_FFI A = toState (Keccak_p`{w = 64, nr = 24} (toString A))

/**
 * A shim to rejigger types for ease of FFI integration into the main
 * Keccak function.
 */
Keccak_p_w64_nr24 : Types::String 64 -> Types::String 64
Keccak_p_w64_nr24 S = toString (Keccak_p_FFI (toState S))
