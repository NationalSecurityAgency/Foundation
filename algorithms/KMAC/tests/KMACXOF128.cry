/*
 * Description: This module provides KMACXOF128 tests
 * [KMACXOF Examples].
 */

module algorithms::KMAC::tests::KMACXOF128 where

import algorithms::KMAC::Main (KMACXOF128)

/*
 * The following properties test KMACXOF128 on the sample values
 * provided by [KMACXOF Examples]. Property names give the sample
 * number used there.
 */

property Sample1 = KMACXOF128`{256} K X S == out
  where
    K   = join [ 0x40_41_42_43_44_45_46_47_48_49_4A_4B_4C_4D_4E_4F
               , 0x50_51_52_53_54_55_56_57_58_59_5A_5B_5C_5D_5E_5F
               ]
    X   = 0x00_01_02_03
    S   = []
    out = join [ 0xCD_83_74_0B_BD_92_CC_C8_CF_03_2B_14_81_A0_F4_46
               , 0x0E_7C_A9_DD_12_B0_8A_0C_40_31_17_8B_AC_D6_EC_35
               ]

property Sample2 = KMACXOF128`{256} K X S == out
  where
    K   = join [ 0x40_41_42_43_44_45_46_47_48_49_4A_4B_4C_4D_4E_4F
               , 0x50_51_52_53_54_55_56_57_58_59_5A_5B_5C_5D_5E_5F
               ]
    X   = 0x00_01_02_03
    S   = join "My Tagged Application"
    out = join [ 0x31_A4_45_27_B4_ED_9F_5C_61_01_D1_1D_E6_D2_6F_06
               , 0x20_AA_5C_34_1D_EF_41_29_96_57_FE_9D_F1_A3_B1_6C
               ]

property Sample3 = KMACXOF128`{256} K X S == out
  where
    K   = join [ 0x40_41_42_43_44_45_46_47_48_49_4A_4B_4C_4D_4E_4F
               , 0x50_51_52_53_54_55_56_57_58_59_5A_5B_5C_5D_5E_5F
               ]
    X   = join [ 0x00_01_02_03_04_05_06_07_08_09_0A_0B_0C_0D_0E_0F
               , 0x10_11_12_13_14_15_16_17_18_19_1A_1B_1C_1D_1E_1F
               , 0x20_21_22_23_24_25_26_27_28_29_2A_2B_2C_2D_2E_2F
               , 0x30_31_32_33_34_35_36_37_38_39_3A_3B_3C_3D_3E_3F
               , 0x40_41_42_43_44_45_46_47_48_49_4A_4B_4C_4D_4E_4F
               , 0x50_51_52_53_54_55_56_57_58_59_5A_5B_5C_5D_5E_5F
               , 0x60_61_62_63_64_65_66_67_68_69_6A_6B_6C_6D_6E_6F
               , 0x70_71_72_73_74_75_76_77_78_79_7A_7B_7C_7D_7E_7F
               , 0x80_81_82_83_84_85_86_87_88_89_8A_8B_8C_8D_8E_8F
               , 0x90_91_92_93_94_95_96_97_98_99_9A_9B_9C_9D_9E_9F
               , 0xA0_A1_A2_A3_A4_A5_A6_A7_A8_A9_AA_AB_AC_AD_AE_AF
               , 0xB0_B1_B2_B3_B4_B5_B6_B7_B8_B9_BA_BB_BC_BD_BE_BF
               ] # 0xC0_C1_C2_C3_C4_C5_C6_C7
    S   = join "My Tagged Application"
    out = join [ 0x47_02_6C_7C_D7_93_08_4A_A0_28_3C_25_3E_F6_58_49
               , 0x0C_0D_B6_14_38_B8_32_6F_E9_BD_DF_28_1B_83_AE_0F
               ]
