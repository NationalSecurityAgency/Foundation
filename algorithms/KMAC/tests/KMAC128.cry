/*
 * Description: This module provides KMAC128 tests [KMAC Examples].
 */

module algorithms::KMAC::tests::KMAC128 where

import algorithms::KMAC::Main (KMAC128)

/*
 * The following properties test KMAC128 on the sample values provided
 * by [KMAC Examples]. Property names give the sample number used
 * there.
 */

property Sample1 = KMAC128`{256} K X S == out
  where
    K   = join [ 0x40414243, 0x44454647, 0x48494a4b, 0x4c4d4e4f
               , 0x50515253, 0x54555657, 0x58595a5b, 0x5c5d5e5f
               ]
    X   = 0x00010203
    S   = []
    out = join [ 0xe5780b0d, 0x3ea6f7d3, 0xa429c570, 0x6aa43a00
               , 0xfadbd7d4, 0x9628839e, 0x3187243f, 0x456ee14e
               ]

property Sample2 = KMAC128`{256} K X S == out
  where
    K   = join [ 0x40414243, 0x44454647, 0x48494a4b, 0x4c4d4e4f
               , 0x50515253, 0x54555657, 0x58595a5b, 0x5c5d5e5f
               ]
    X   = 0x00010203
    S   = join "My Tagged Application"
    out = join [ 0x3b1fba96, 0x3cd8b0b5, 0x9e8c1a6d, 0x71888b71
               , 0x43651af8, 0xba0a7070, 0xc0979e28, 0x11324aa5
               ]

property Sample3 = KMAC128`{256} K X S == out
  where
    K   = join [ 0x40414243, 0x44454647, 0x48494a4b, 0x4c4d4e4f
               , 0x50515253, 0x54555657, 0x58595a5b, 0x5c5d5e5f
               ]
    X   = join [ 0x00010203, 0x04050607, 0x08090a0b, 0x0c0d0e0f
               , 0x10111213, 0x14151617, 0x18191a1b, 0x1c1d1e1f
               , 0x20212223, 0x24252627, 0x28292a2b, 0x2c2d2e2f
               , 0x30313233, 0x34353637, 0x38393a3b, 0x3c3d3e3f
               , 0x40414243, 0x44454647, 0x48494a4b, 0x4c4d4e4f
               , 0x50515253, 0x54555657, 0x58595a5b, 0x5c5d5e5f
               , 0x60616263, 0x64656667, 0x68696a6b, 0x6c6d6e6f
               , 0x70717273, 0x74757677, 0x78797a7b, 0x7c7d7e7f
               , 0x80818283, 0x84858687, 0x88898a8b, 0x8c8d8e8f
               , 0x90919293, 0x94959697, 0x98999a9b, 0x9c9d9e9f
               , 0xa0a1a2a3, 0xa4a5a6a7, 0xa8a9aaab, 0xacadaeaf
               , 0xb0b1b2b3, 0xb4b5b6b7, 0xb8b9babb, 0xbcbdbebf
               , 0xc0c1c2c3, 0xc4c5c6c7
               ]
    S   = join "My Tagged Application"
    out = join [ 0x1f5b4e6c, 0xca02209e, 0x0dcb5ca6, 0x35b89a15
               , 0xe271ecc7, 0x60071dfd, 0x805faa38, 0xf9729230
               ]
