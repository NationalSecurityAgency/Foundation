/*
 * Description: This module provides KMACXOF256 tests
 * [KMACXOF Examples].
 */

module algorithms::KMAC::tests::KMACXOF256 where

import algorithms::KMAC::Main (KMACXOF256)

/*
 * The following properties test KMACXOF256 on the sample values
 * provided by [KMACXOF Examples]. Property names give the sample
 * number used there.
 */

property Sample4 = KMACXOF256`{512} K X S == out
  where
    K   = join [ 0x40414243, 0x44454647, 0x48494a4b, 0x4c4d4e4f
               , 0x50515253, 0x54555657, 0x58595a5b, 0x5c5d5e5f
               ]
    X   = 0x00010203
    S   = join "My Tagged Application"
    out = join [ 0x1755133f, 0x1534752a, 0xad0748f2, 0xc706fb5c
               , 0x784512ca, 0xb835cd15, 0x676b16c0, 0xc6647fa9
               , 0x6faa7af6, 0x34a0bf8f, 0xf6df3937, 0x4fa00fad
               , 0x9a39e322, 0xa7c92065, 0xa64eb1fb, 0x0801eb2b
               ]

