/*
 * Description: This module provides KMACXOF256 tests
 * [KMACXOF Examples].
 */

module algorithms::KMAC::tests::KMACXOF256 where

import algorithms::KMAC::Main (KMACXOF256)

/*
 * The following properties test KMACXOF256 on the sample values
 * provided by [KMACXOF Examples]. Property names give the sample
 * number used there.
 */

property Sample4 = KMACXOF256`{512} K X S == out
  where
    K   = join [ 0x40_41_42_43_44_45_46_47_48_49_4A_4B_4C_4D_4E_4F
               , 0x50_51_52_53_54_55_56_57_58_59_5A_5B_5C_5D_5E_5F
               ]
    X   = 0x00_01_02_03
    S   = join "My Tagged Application"
    out = join [ 0x17_55_13_3F_15_34_75_2A_AD_07_48_F2_C7_06_FB_5C
               , 0x78_45_12_CA_B8_35_CD_15_67_6B_16_C0_C6_64_7F_A9
               , 0x6F_AA_7A_F6_34_A0_BF_8F_F6_DF_39_37_4F_A0_0F_AD
               , 0x9A_39_E3_22_A7_C9_20_65_A6_4E_B1_FB_08_01_EB_2B
               ]

