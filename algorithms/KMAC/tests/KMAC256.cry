/*
 * Description: This module provides KMAC256 tests [KMAC Examples].
 */

module algorithms::KMAC::tests::KMAC256 where

import algorithms::KMAC::Main (KMAC256)

/*
 * The following properties test KMAC256 on the sample values provided
 * by [KMAC Examples]. Property names give the sample number used
 * there.
 */

property Sample4 = KMAC256`{512} K X S == out
  where
    K   = join [ 0x40_41_42_43_44_45_46_47_48_49_4A_4B_4C_4D_4E_4F
               , 0x50_51_52_53_54_55_56_57_58_59_5A_5B_5C_5D_5E_5F
               ]
    X   = 0x00_01_02_03
    S   = join "My Tagged Application"
    out = join [ 0x20_C5_70_C3_13_46_F7_03_C9_AC_36_C6_1C_03_CB_64
               , 0xC3_97_0D_0C_FC_78_7E_9B_79_59_9D_27_3A_68_D2_F7
               , 0xF6_9D_4C_C3_DE_9D_10_4A_35_16_89_F2_7C_F6_F5_95
               , 0x1F_01_03_F3_3F_4F_24_87_10_24_D9_C2_77_73_A8_DD
               ]

