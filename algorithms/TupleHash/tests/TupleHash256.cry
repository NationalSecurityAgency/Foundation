/*
 * Description: This module provides TupleHash256 tests
 * [TupleHash Examples].
 */

module algorithms::TupleHash::tests::TupleHash256 where

import algorithms::TupleHash::Main (TupleHash256, addElementToTuple)

/*
 * The following properties test TupleHash256 on the sample values
 * provided by [TupleHash Examples]. Property names give the sample
 * number used there.
 */

property Sample4 = TupleHash256`{512} X S == out
  where
    X0  = addElementToTuple [] 0x000102
    X   = addElementToTuple X0 0x101112131415
    S   = []
    out = join [ 0xcfb7058c, 0xaca5e668, 0xf81a12a2, 0x0a2195ce
               , 0x97a925f1, 0xdba3e744, 0x9a56f822, 0x01ec6073
               , 0x11ac2696, 0xb1ab5ea2, 0x352df142, 0x3bde7bd4
               , 0xbb78c9ae, 0xd1a853c7, 0x8672f9eb, 0x23bbe194
               ]

property Sample5 = TupleHash256`{512} X S == out
  where
    X0  = addElementToTuple [] 0x000102
    X   = addElementToTuple X0 0x101112131415
    S   = join "My Tuple App"
    out = join [ 0x147c2191, 0xd5ed7efd, 0x98dbd96d, 0x7ab5a116
               , 0x92576f5f, 0xe2a5065f, 0x3e33de6b, 0xba9f3aa1
               , 0xc4e9a068, 0xa289c61c, 0x95aab30a, 0xee1e410b
               , 0x0b607de3, 0x620e24a4, 0xe3bf9852, 0xa1d4367e
               ]

property Sample6 = TupleHash256`{512} X S == out
  where
    X0  = addElementToTuple [] 0x000102
    X1  = addElementToTuple X0 0x101112131415
    X   = addElementToTuple X1 0x202122232425262728
    S   = join "My Tuple App"
    out = join [ 0x45000be6, 0x3f9b6bfd, 0x89f54717, 0x670f69a9
               , 0xbc763591, 0xa4f05c50, 0xd68891a7, 0x44bcc6e7
               , 0xd6d5b5e8, 0x2c018da9, 0x99ed35b0, 0xbb49c967
               , 0x8e526abd, 0x8e85c13e, 0xd254021d, 0xb9e790ce
               ]
