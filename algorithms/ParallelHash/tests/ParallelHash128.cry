/*
 * Description: This module provides ParallelHash128 tests
 * [ParallelHash Examples].
 */

module algorithms::ParallelHash::tests::ParallelHash128 where

import algorithms::ParallelHash::Main (ParallelHash128)

/*
 * The following properties test ParallelHash128 on the sample values
 * provided by [ParallelHash Examples]. Property names give the sample
 * number used there.
 */

property Sample1 = ParallelHash128`{L = 256, B = 8} X S == out
  where
    X   = join [ 0x00010203, 0x04050607, 0x10111213, 0x14151617
               , 0x20212223, 0x24252627
               ]
    S   = []
    out = join [ 0xba8dc1d1, 0xd979331d, 0x3f813603, 0xc67f7260
               , 0x9ab5e44b, 0x94a0b8f9, 0xaf465144, 0x54a2b4f5
               ]

property Sample2 = ParallelHash128`{L = 256, B = 8} X S == out
  where
    X   = join [ 0x00010203, 0x04050607, 0x10111213, 0x14151617
               , 0x20212223, 0x24252627
               ]
    S   = join "Parallel Data"
    out = join [ 0xfc484dcb, 0x3f84dcee, 0xdc353438, 0x151bee58
               , 0x157d6efe, 0xd0445a81, 0xf165e495, 0x795b7206
               ]

property Sample3 = ParallelHash128`{L = 256, B = 12} X S == out
  where
    X   = join [ 0x00010203, 0x04050607, 0x08090a0b, 0x10111213
               , 0x14151617, 0x18191a1b, 0x20212223, 0x24252627
               , 0x28292a2b, 0x30313233, 0x34353637, 0x38393a3b
               , 0x40414243, 0x44454647, 0x48494a4b, 0x50515253
               , 0x54555657, 0x58595a5b
               ]
    S   = join "Parallel Data"
    out = join [ 0xf7fd5312, 0x896c6685, 0xc828af7e, 0x2adb97e3
               , 0x93e7f8d5, 0x4e3c2ea4, 0xb95e5aca, 0x3796e8fc
               ]
