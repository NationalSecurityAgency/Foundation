/*
 * Description: This module provides HKDF tests [RFC5869 Appendix A].
 */

module algorithms::HKDF::tests::RFC5869 where

import algorithms::HKDF::Main (HKDF, HKDF_Extract, HKDF_Expand)
import algorithms::SHA1::Main as SHA1
import algorithms::SHA2::SHA256 as SHA256

/*
 * The following properties test HKDF on the test vectors provided by
 * [RFC5869 Appendix A]. Each property checks the pseudorandom key
 * produced by `HKDF_Extract`, the output keying material produced by
 * `HKDF_Expand` from that key, and the composition `HKDF`.
 */

property TestCase1 =
    HKDF_Extract SHA256::HMAC salt IKM == PRK
 /\ HKDF_Expand`{L = 42} SHA256::HMAC SHA256::HMAC PRK info == OKM
 /\ HKDF SHA256::HMAC SHA256::HMAC SHA256::HMAC salt IKM info == OKM
  where
    IKM  = split 0x0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b
    salt = split 0x000102030405060708090a0b0c
    info = split 0xf0f1f2f3f4f5f6f7f8f9
    PRK  = split (join [ 0x077709362c2e32df0ddc3f0dc47bba63
                       , 0x90b6c73bb50f9c3122ec844ad7c2b3e5
                       ])
    OKM  = split (join [ 0x3cb25f25faacd57a90434f64d0362f2a
                       , 0x2d2d0a90cf1a5a4c5db02d56ecc4c5bf
                       ] # 0x34007208d5b887185865)

property TestCase2 =
    HKDF_Extract SHA256::HMAC salt IKM == PRK
 /\ HKDF_Expand`{L = 82} SHA256::HMAC SHA256::HMAC PRK info == OKM
 /\ HKDF SHA256::HMAC SHA256::HMAC SHA256::HMAC salt IKM info == OKM
  where
    IKM  = split (join [ 0x000102030405060708090a0b0c0d0e0f
                       , 0x101112131415161718191a1b1c1d1e1f
                       , 0x202122232425262728292a2b2c2d2e2f
                       , 0x303132333435363738393a3b3c3d3e3f
                       , 0x404142434445464748494a4b4c4d4e4f
                       ])
    salt = split (join [ 0x606162636465666768696a6b6c6d6e6f
                       , 0x707172737475767778797a7b7c7d7e7f
                       , 0x808182838485868788898a8b8c8d8e8f
                       , 0x909192939495969798999a9b9c9d9e9f
                       , 0xa0a1a2a3a4a5a6a7a8a9aaabacadaeaf
                       ])
    info = split (join [ 0xb0b1b2b3b4b5b6b7b8b9babbbcbdbebf
                       , 0xc0c1c2c3c4c5c6c7c8c9cacbcccdcecf
                       , 0xd0d1d2d3d4d5d6d7d8d9dadbdcdddedf
                       , 0xe0e1e2e3e4e5e6e7e8e9eaebecedeeef
                       , 0xf0f1f2f3f4f5f6f7f8f9fafbfcfdfeff
                       ])
    PRK  = split (join [ 0x06a6b88c5853361a06104c9ceb35b45c
                       , 0xef760014904671014a193f40c15fc244
                       ])
    OKM  = split (join [ 0xb11e398dc80327a1c8e7f78c596a4934
                       , 0x4f012eda2d4efad8a050cc4c19afa97c
                       , 0x59045a99cac7827271cb41c65e590e09
                       , 0xda3275600c2f09b8367793a9aca3db71
                       , 0xcc30c58179ec3e87c14c01d5c1f3434f
                       ] # 0x1d87)

property TestCase3 =
    HKDF_Extract SHA256::HMAC salt IKM == PRK
 /\ HKDF_Expand`{L = 42} SHA256::HMAC SHA256::HMAC PRK info == OKM
 /\ HKDF SHA256::HMAC SHA256::HMAC SHA256::HMAC salt IKM info == OKM
  where
    IKM  = split 0x0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b
    salt = []
    info = []
    PRK  = split (join [ 0x19ef24a32c717b167f33a91d6f648bdf
                       , 0x96596776afdb6377ac434c1c293ccb04
                       ])
    OKM  = split (join [ 0x8da4e775a563c18f715f802a063c5a31
                       , 0xb8a11f5c5ee1879ec3454e5f3c738d2d
                       ] # 0x9d201395faa4b61a96c8)

property TestCase4 =
    HKDF_Extract SHA1::HMAC salt IKM == PRK
 /\ HKDF_Expand`{L = 42} SHA1::HMAC SHA1::HMAC PRK info == OKM
 /\ HKDF SHA1::HMAC SHA1::HMAC SHA1::HMAC salt IKM info == OKM
  where
    IKM  = split 0x0b0b0b0b0b0b0b0b0b0b0b
    salt = split 0x000102030405060708090a0b0c
    info = split 0xf0f1f2f3f4f5f6f7f8f9
    PRK  = split 0x9b6c18c432a7bf8f0e71c8eb88f4b30baa2ba243
    OKM  = split (join [ 0x085a01ea1b10f36933068b56efa5ad81
                       , 0xa4f14b822f5b091568a9cdd4f155fda2
                       ] # 0xc22e422478d305f3f896)

property TestCase5 =
    HKDF_Extract SHA1::HMAC salt IKM == PRK
 /\ HKDF_Expand`{L = 82} SHA1::HMAC SHA1::HMAC PRK info == OKM
 /\ HKDF SHA1::HMAC SHA1::HMAC SHA1::HMAC salt IKM info == OKM
  where
    IKM  = split (join [ 0x000102030405060708090a0b0c0d0e0f
                       , 0x101112131415161718191a1b1c1d1e1f
                       , 0x202122232425262728292a2b2c2d2e2f
                       , 0x303132333435363738393a3b3c3d3e3f
                       , 0x404142434445464748494a4b4c4d4e4f
                       ])
    salt = split (join [ 0x606162636465666768696a6b6c6d6e6f
                       , 0x707172737475767778797a7b7c7d7e7f
                       , 0x808182838485868788898a8b8c8d8e8f
                       , 0x909192939495969798999a9b9c9d9e9f
                       , 0xa0a1a2a3a4a5a6a7a8a9aaabacadaeaf
                       ])
    info = split (join [ 0xb0b1b2b3b4b5b6b7b8b9babbbcbdbebf
                       , 0xc0c1c2c3c4c5c6c7c8c9cacbcccdcecf
                       , 0xd0d1d2d3d4d5d6d7d8d9dadbdcdddedf
                       , 0xe0e1e2e3e4e5e6e7e8e9eaebecedeeef
                       , 0xf0f1f2f3f4f5f6f7f8f9fafbfcfdfeff
                       ])
    PRK  = split 0x8adae09a2a307059478d309b26c4115a224cfaf6
    OKM  = split (join [ 0x0bd770a74d1160f7c9f12cd5912a06eb
                       , 0xff6adcae899d92191fe4305673ba2ffe
                       , 0x8fa3f1a4e5ad79f3f334b3b202b2173c
                       , 0x486ea37ce3d397ed034c7f9dfeb15c5e
                       , 0x927336d0441f4c4300e2cff0d0900b52
                       ] # 0xd3b4)

property TestCase6 =
    HKDF_Extract SHA1::HMAC salt IKM == PRK
 /\ HKDF_Expand`{L = 42} SHA1::HMAC SHA1::HMAC PRK info == OKM
 /\ HKDF SHA1::HMAC SHA1::HMAC SHA1::HMAC salt IKM info == OKM
  where
    IKM  = split 0x0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b
    salt = []
    info = []
    PRK  = split 0xda8c8a73c7fa77288ec6f5e7c297786aa0d32d01
    OKM  = split (join [ 0x0ac1af7002b3d761d1e55298da9d0506
                       , 0xb9ae52057220a306e07b6b87e8df21d0
                       ] # 0xea00033de03984d34918)

/*
 * In test case 7 the salt is not provided, so it defaults to
 * `HashLen` zero bytes [RFC5869 Section 2.2].
 */
property TestCase7 =
    HKDF_Extract SHA1::HMAC salt IKM == PRK
 /\ HKDF_Expand`{L = 42} SHA1::HMAC SHA1::HMAC PRK info == OKM
 /\ HKDF SHA1::HMAC SHA1::HMAC SHA1::HMAC salt IKM info == OKM
  where
    IKM  = split 0x0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c
    salt = zero : [20][8]
    info = []
    PRK  = split 0x2adccada18779e7c2077ad2eb19d3f3e731385dd
    OKM  = split (join [ 0x2c91117204d745f3500d636a62f64f0a
                       , 0xb3bae548aa53d423b0d1f27ebba6f5e5
                       ] # 0x673a081d70cce7acfc48)

/*
 * The following property checks that requesting fewer bytes of
 * output keying material yields a prefix of the longer output, since
 * `OKM` is the first `L` octets of `T` [RFC5869 Section 2.3].
 */
property ExpandIsPrefixClosed (PRK : [32][8]) (info : [4][8]) =
    HKDF_Expand`{L = 33} SHA256::HMAC SHA256::HMAC PRK info
 == take (HKDF_Expand`{L = 70} SHA256::HMAC SHA256::HMAC PRK info)
