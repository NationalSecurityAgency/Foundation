/*
 * The following properties test SHAKE256 on byte oriented
 * messages. All test vectors have been provided by [Byte
 * Examples]. The properties below do not utilize the full set of
 * provided test vectors. Numbers after the property name give the
 * length in bits of the message.
 */

property byte0 = 
    hash`{256} (0 : [0]) == 0x46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f

property byte40 = 
    hash`{256} 0xe82f4188ab == 0xf4bf0c76beee2abd6156b41afef4142c3dbabfede5b9ce2ecd282fb294669731
  
property byte64 =
    hash`{256} 0x587cb398fe82ffda == 0x54f5dddb85f62dba7dc4727d502bdee959fb665bd482bd0ce31cbdd1a042e4b5

property byte2176 = 
    hash`{256}  == 0x46293a63c235750d58a24edca5ba637b96cae74325c6c8122c4155c0d15805e6
