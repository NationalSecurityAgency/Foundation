/*
 * Description: This module provides SHAKE256 tests [Bit Examples,
 * Byte Examples].
 */

module algorithms::SHAKE::tests::SHAKE256 where

import algorithms::SHAKE::Main (SHAKE256)
import algorithms::Keccak::Main (bitReordering)

hash : {DigestSize, a} (fin DigestSize, fin a) => [a] -> [DigestSize]
hash = SHAKE256`{DigestSize}

/*
 * The following properties test SHAKE256 on bit-oriented test
 * vectors. All examples are provided by [Bit Examples] which uses a
 * collection of shared messages.
 */

