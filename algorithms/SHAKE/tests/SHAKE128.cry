/*
 * Description: This module provides SHAKE128 tests [Bit Examples,
 * Byte Examples].
 */

module algorithms::SHAKE::tests::SHAKE128 where

import algorithms::SHAKE::Main (SHAKE128)
import algorithms::Keccak::Main (bitReordering)

hash : {DigestSize, a} (fin DigestSize, fin a) => [a] -> [DigestSize]
hash = SHAKE128`{DigestSize}

