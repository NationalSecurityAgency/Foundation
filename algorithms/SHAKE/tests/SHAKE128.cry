/*
 * The following properties test SHAKE128 on byte oriented
 * messages. All test vectors have been provided by [Byte
 * Examples]. The properties below do not utilize the full set of
 * provided test vectors. Numbers after the property name give the
 * length in bits of the message.
 */

property byte0 = 
    hash`{128} (0 : [0]) == 0x7f9c2ba4e88f827d616045507605853e

property byte40 =
    hash`{128} 0x76fc16763f == 0xa539f540f3e69e2d25a46ef0b1cf16dd

property byte64 = 
    hash`{128} 0x7bf2fef375bcaff3 == 0x5ef5578b89c50532131b7843de7329a3

property byte2688 =
    hash`{128}  == 0xb4813895ae01b43c9d9ed85a8b03aaf4
