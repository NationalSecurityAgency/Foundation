/*
 * Description: This is a Cryptol specification for the Secure Hash
 * Algorithm-3 512 (SHA3-512) [FIPS-PUB-202 Section 6.1].
 */

module algorithms::SHA3::SHA3_512 = packaging::Hash where

import algorithms::Keccak::Main (Keccak, bitReordering)

type _BlockSize  = 72 * 8
type _DigestSize = 512
type _UpperLimit = inf

_hash M = bitReordering R
  where
    M' = bitReordering M
    R  = Keccak`{1024, _DigestSize} (M' # 0b01)
