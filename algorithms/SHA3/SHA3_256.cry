/*
 * Description: This is a Cryptol specification for the Secure Hash
 * Algorithm-3 256 (SHA3-256) [FIPS-PUB-202 Section 6.1].
 */

module algorithms::SHA3::SHA3_256 = packaging::Hash where

import algorithms::Keccak::Main (Keccak, bitReordering)

type _BlockSize  = 136 * 8
type _DigestSize = 256
type _UpperLimit = inf

_hash M = bitReordering R
  where
    M' = bitReordering M
    R  = Keccak`{512, _DigestSize} (M' # 0b01)
