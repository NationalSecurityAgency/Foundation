/*
 * Description: This module provides SHA3-512 tests [Bit Examples].
 */

module algorithms::SHA3::tests::SHA3_512::BitExamples where

import algorithms::SHA3::SHA3_512 as SHA3_512
import algorithms::SHA3::tests::Messages
import algorithms::Keccak::Main (bitReordering)

/**
 * This is a helper function that rejiggers `SHA3-512` to allow binary
 * inputs, the format the example messages are provided in.
 */
hash : {a} (fin a) => [a] -> [SHA3_512::DigestSize]
hash M = SHA3_512::hash (bitReordering M)

/*
 * The following properties test SHA3-512 on bit-oriented test
 * vectors. All examples are provided by [Bit Examples] which uses a
 * collection of shared messages.
 */

property Msg0_check = 
    hash Msg0    == join [ 0xA6, 0x9F, 0x73, 0xCC, 0xA2, 0x3A, 0x9A, 0xC5, 0xC8, 0xB5, 0x67, 0xDC, 0x18, 0x5A, 0x75, 0x6E
                         , 0x97, 0xC9, 0x82, 0x16, 0x4F, 0xE2, 0x58, 0x59, 0xE0, 0xD1, 0xDC, 0xC1, 0x47, 0x5C, 0x80, 0xA6
                         , 0x15, 0xB2, 0x12, 0x3A, 0xF1, 0xF5, 0xF9, 0x4C, 0x11, 0xE3, 0xE9, 0x40, 0x2C, 0x3A, 0xC5, 0x58
                         , 0xF5, 0x00, 0x19, 0x9D, 0x95, 0xB6, 0xD3, 0xE3, 0x01, 0x75, 0x85, 0x86, 0x28, 0x1D, 0xCD, 0x26
                         ]
