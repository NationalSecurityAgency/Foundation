/*
 * Description: This module provides SHA3-224 tests [Bit Examples].
 */

module algorithms::SHA3::tests::SHA3_224::BitExamples where

import algorithms::SHA3::SHA3_224 as SHA3_224
import algorithms::SHA3::tests::Messages
import algorithms::Keccak::Main (bitReordering)

/**
 * This is a helper function that rejiggers `SHA3-224` to allow binary
 * inputs, the format the example messages are provided in.
 */
hash : {a} (fin a) => [a] -> [SHA3_224::DigestSize]
hash M = SHA3_224::hash (bitReordering M)

/*
 * The following properties test SHA3-224 on bit-oriented test
 * vectors. All examples are provided by [Bit Examples] which uses a
 * collection of shared messages.
 */

property Msg0_check = 
    hash Msg0    == join [ 0x6B, 0x4E, 0x03, 0x42, 0x36, 0x67, 0xDB
                         , 0xB7, 0x3B, 0x6E, 0x15, 0x45, 0x4F, 0x0E
                         , 0xB1, 0xAB, 0xD4, 0x59, 0x7F, 0x9A, 0x1B
                         , 0x07, 0x8E, 0x3F, 0x5B, 0x5A, 0x6B, 0xC7 
                         ]
property Msg5_check = 
    hash Msg5    == join [ 0xFF, 0xBA, 0xD5, 0xDA, 0x96, 0xBA, 0xD7
                         , 0x17, 0x89, 0x33, 0x02, 0x06, 0xDC, 0x67
                         , 0x68, 0xEC, 0xAE, 0xB1, 0xB3, 0x2D, 0xCA
                         , 0x6B, 0x33, 0x01, 0x48, 0x96, 0x74, 0xAB
                         ]
property Msg30_check =
    hash Msg30   == join [ 0xD6, 0x66, 0xA5, 0x14, 0xCC, 0x9D, 0xBA
                         , 0x25, 0xAC, 0x1B, 0xA6, 0x9E, 0xD3, 0x93
                         , 0x04, 0x60, 0xDE, 0xAA, 0xC9, 0x85, 0x1B
                         , 0x5F, 0x0B, 0xAA, 0xB0, 0x07, 0xDF, 0x3B
                         ]
property Msg1600_check =
    hash Msg1600 == join [ 0x93, 0x76, 0x81, 0x6A, 0xBA, 0x50, 0x3F
                         , 0x72, 0xF9, 0x6C, 0xE7, 0xEB, 0x65, 0xAC
                         , 0x09, 0x5D, 0xEE, 0xE3, 0xBE, 0x4B, 0xF9
                         , 0xBB, 0xC2, 0xA1, 0xCB, 0x7E, 0x11, 0xE0
                         ]
property Msg1605_check =
    hash Msg1605 == join [ 0x22, 0xD2, 0xF7, 0xBB, 0x0B, 0x17, 0x3F
                         , 0xD8, 0xC1, 0x96, 0x86, 0xF9, 0x17, 0x31
                         , 0x66, 0xE3, 0xEE, 0x62, 0x73, 0x80, 0x47
                         , 0xD7, 0xEA, 0xDD, 0x69, 0xEF, 0xB2, 0x28
                         ]
property Msg1630_check =
    hash Msg1630 == join [ 0x4E, 0x90, 0x7B, 0xB1, 0x05, 0x78, 0x61
                         , 0xF2, 0x00, 0xA5, 0x99, 0xE9, 0xD4, 0xF8
                         , 0x5B, 0x02, 0xD8, 0x84, 0x53, 0xBF, 0x5B
                         , 0x8A, 0xCE, 0x9A, 0xC5, 0x89, 0x13, 0x4C
                         ]
