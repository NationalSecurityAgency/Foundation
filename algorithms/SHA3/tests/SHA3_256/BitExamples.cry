/*
 * Description: This module provides SHA3-256 tests [Bit Examples].
 */

module algorithms::SHA3::tests::SHA3_256::BitExamples where

import algorithms::SHA3::SHA3_256 as SHA3_256
import algorithms::SHA3::tests::Messages
import algorithms::Keccak::Main (bitReordering)

/**
 * This is a helper function that rejiggers `SHA3-256` to produce
 * hexadecimal outputs, the format the examples below are provided in.
 */
hash : {a} (fin a) => [a] -> [SHA3_256::DigestSize]
hash M = SHA3_256::hash (bitReordering M)

/*
 * The following properties test SHA3-256 on bit-oriented test
 * vectors. All examples are provided by [Bit Examples] which
 * uses a collection of shared messages.
 */

property Msg0_check = 
    hash Msg0    == join [ 0xA7, 0xFF, 0xC6, 0xF8, 0xBF, 0x1E, 0xD7, 0x66, 0x51, 0xC1, 0x47, 0x56, 0xA0, 0x61, 0xD6, 0x62
                         , 0xF5, 0x80, 0xFF, 0x4D, 0xE4, 0x3B, 0x49, 0xFA, 0x82, 0xD8, 0x0A, 0x4B, 0x80, 0xF8, 0x43, 0x4A
                         ]
property Msg5_check =  
    hash Msg5    == join [ 0x7B, 0x00, 0x47, 0xCF, 0x5A, 0x45, 0x68, 0x82, 0x36, 0x3C, 0xBF, 0x0F, 0xB0, 0x53, 0x22, 0xCF
                         , 0x65, 0xF4, 0xB7, 0x05, 0x9A, 0x46, 0x36, 0x5E, 0x83, 0x01, 0x32, 0xE3, 0xB5, 0xD9, 0x57, 0xAF
                         ]
property Msg30_check =
    hash Msg30   == join [ 0xC8, 0x24, 0x2F, 0xEF, 0x40, 0x9E, 0x5A, 0xE9, 0xD1, 0xF1, 0xC8, 0x57, 0xAE, 0x4D, 0xC6, 0x24
                         , 0xB9, 0x2B, 0x19, 0x80, 0x9F, 0x62, 0xAA, 0x8C, 0x07, 0x41, 0x1C, 0x54, 0xA0, 0x78, 0xB1, 0xD0
                         ]
property Msg1600_check =
    hash Msg1600 == join [ 0x79, 0xF3, 0x8A, 0xDE, 0xC5, 0xC2, 0x03, 0x07, 0xA9, 0x8E, 0xF7, 0x6E, 0x83, 0x24, 0xAF, 0xBF
                         , 0xD4, 0x6C, 0xFD, 0x81, 0xB2, 0x2E, 0x39, 0x73, 0xC6, 0x5F, 0xA1, 0xBD, 0x9D, 0xE3, 0x17, 0x87
                         ]
property Msg1605_check =
    hash Msg1605 == join [ 0x81, 0xEE, 0x76, 0x9B, 0xED, 0x09, 0x50, 0x86, 0x2B, 0x1D, 0xDD, 0xED, 0x2E, 0x84, 0xAA, 0xA6
                         , 0xAB, 0x7B, 0xFD, 0xD3, 0xCE, 0xAA, 0x47, 0x1B, 0xE3, 0x11, 0x63, 0xD4, 0x03, 0x36, 0x36, 0x3C
                         ]
property Msg1630_check =
    hash Msg1630 == join [ 0x52, 0x86, 0x0A, 0xA3, 0x01, 0x21, 0x4C, 0x61, 0x0D, 0x92, 0x2A, 0x6B, 0x6C, 0xAB, 0x98, 0x1C
                         , 0xCD, 0x06, 0x01, 0x2E, 0x54, 0xEF, 0x68, 0x9D, 0x74, 0x40, 0x21, 0xE7, 0x38, 0xB9, 0xED, 0x20
                         ]
