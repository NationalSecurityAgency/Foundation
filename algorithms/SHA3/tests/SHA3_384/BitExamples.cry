/*
 * Description: This module provides SHA3-384 tests [Bit Examples].
 */

module algorithms::SHA3::tests::SHA3_384::BitExamples where

import algorithms::SHA3::SHA3_384 as SHA3_384
import algorithms::SHA3::tests::Messages
import algorithms::Keccak::Main (bitReordering)

/**
 * This is a helper function that rejiggers `SHA3-384` to produce
 * hexadecimal outputs, the format the examples below are provided in.
 */
hash : {a} (fin a) => [a] -> [SHA3_384::DigestSize]
hash M = SHA3_384::hash (bitReordering M)

/*
 * The following properties test SHA3-384 on bit-oriented test
 * vectors. All examples are provided by [Bit Examples] which uses a
 * collection of shared messages.
 */

property Msg0_check = 
    hash Msg0   == join [ 0x0C, 0x63, 0xA7, 0x5B, 0x84, 0x5E, 0x4F, 0x7D, 0x01, 0x10, 0x7D, 0x85, 0x2E, 0x4C, 0x24, 0x85
                        , 0xC5, 0x1A, 0x50, 0xAA, 0xAA, 0x94, 0xFC, 0x61, 0x99, 0x5E, 0x71, 0xBB, 0xEE, 0x98, 0x3A, 0x2A
                        , 0xC3, 0x71, 0x38, 0x31, 0x26, 0x4A, 0xDB, 0x47, 0xFB, 0x6B, 0xD1, 0xE0, 0x58, 0xD5, 0xF0, 0x04
                        ]
property Msg5_check =
    hash Msg5   == join [ 0x73, 0x7C, 0x9B, 0x49, 0x18, 0x85, 0xE9, 0xBF, 0x74, 0x28, 0xE7, 0x92, 0x74, 0x1A, 0x7B, 0xF8
                        , 0xDC, 0xA9, 0x65, 0x34, 0x71, 0xC3, 0xE1, 0x48, 0x47, 0x3F, 0x2C, 0x23, 0x6B, 0x6A, 0x0A, 0x64
                        , 0x55, 0xEB, 0x1D, 0xCE, 0x9F, 0x77, 0x9B, 0x4B, 0x6B, 0x23, 0x7F, 0xEF, 0x17, 0x1B, 0x1C, 0x64
                         ]
property Msg30_check =
    hash Msg30   == join [ 0x95, 0x5B, 0x4D, 0xD1, 0xBE, 0x03, 0x26, 0x1B, 0xD7, 0x6F, 0x80, 0x7A, 0x7E, 0xFD, 0x43, 0x24
                         , 0x35, 0xC4, 0x17, 0x36, 0x28, 0x11, 0xB8, 0xA5, 0x0C, 0x56, 0x4E, 0x7E, 0xE9, 0x58, 0x5E, 0x1A
                         , 0xC7, 0x62, 0x6D, 0xDE, 0x2F, 0xDC, 0x03, 0x0F, 0x87, 0x61, 0x96, 0xEA, 0x26, 0x7F, 0x08, 0xC3
                         ]
property Msg1600_check =
    hash Msg1600 == join [ 0x18, 0x81, 0xDE, 0x2C, 0xA7, 0xE4, 0x1E, 0xF9, 0x5D, 0xC4, 0x73, 0x2B, 0x8F, 0x5F, 0x00, 0x2B
                         , 0x18, 0x9C, 0xC1, 0xE4, 0x2B, 0x74, 0x16, 0x8E, 0xD1, 0x73, 0x26, 0x49, 0xCE, 0x1D, 0xBC, 0xDD
                         , 0x76, 0x19, 0x7A, 0x31, 0xFD, 0x55, 0xEE, 0x98, 0x9F, 0x2D, 0x70, 0x50, 0xDD, 0x47, 0x3E, 0x8F
                         ]
property Msg1605_check =
    hash Msg1605 == join [ 0xA3, 0x1F, 0xDB, 0xD8, 0xD5, 0x76, 0x55, 0x1C, 0x21, 0xFB, 0x11, 0x91, 0xB5, 0x4B, 0xDA, 0x65
                         , 0xB6, 0xC5, 0xFE, 0x97, 0xF0, 0xF4, 0xA6, 0x91, 0x03, 0x42, 0x4B, 0x43, 0xF7, 0xFD, 0xB8, 0x35
                         , 0x97, 0x9F, 0xDB, 0xEA, 0xE8, 0xB3, 0xFE, 0x16, 0xCB, 0x82, 0xE5, 0x87, 0x38, 0x1E, 0xB6, 0x24
                         ]
property Msg1630_check =
    hash Msg1630 == join [ 0x34, 0x85, 0xD3, 0xB2, 0x80, 0xBD, 0x38, 0x4C, 0xF4, 0xA7, 0x77, 0x84, 0x4E, 0x94, 0x67, 0x81
                         , 0x73, 0x05, 0x5D, 0x1C, 0xBC, 0x40, 0xC7, 0xC2, 0xC3, 0x83, 0x3D, 0x9E, 0xF1, 0x23, 0x45, 0x17
                         , 0x2D, 0x6F, 0xCD, 0x31, 0x92, 0x3B, 0xB8, 0x79, 0x5A, 0xC8, 0x18, 0x47, 0xD3, 0xD8, 0x85, 0x5C
                         ]
