/*
 * Description: This module provides "routines for implementing
 * primitives for elliptic curve cryptography on the NIST elliptic
 * curves P-192, P-224, P-256, P-384, P-521" [NSA19].
 */

module algorithms::ECDSA::Routines where

import shared::common::utils::TypeCoercion (BVtoZ, ZtoZ, ZtoBV)
import shared::common::utils::Enum

parameter
  /**
   * `p` is an odd prime number > 3 [NSA19 Section 1], used to make an
   * elliptic curve over `GF(p)`.
   */
  type p : #
  type constraint (fin p, prime p, p > 8)  // `p > 8` comes from scalar multiplications.

  /**
   * Elliptic curve parameter. y ^^ 2 == x ^^ 3 - 3 * x + b [NSA19
   * Section 1].
   */
  b : Z p

  /**
   * Modular square root function specialized on `p` [NSA19 Section
   * 3.2].
   */
  mp_mod_sqrt : Z p -> Z p

/**
 * Bit-length of `p` [NSA19 Section 1].
 */
type n = width p

/**
 * "The affine representations of `S` is a pair `S = (Sx, Sy)` of
 * elements of `GF(p)` which satisfy the defining equation [NSA19
 * Section 2.2]."
 */ 
type AffinePoint = { x : Z p, y : Z p }

/**
 * A projective representation of `S` is a triple `S = (Sx, Sy, Sz) of
 * elements of `GF(p)`, such that `Sy ^^ 2 == Sx ^^ 3 * Sz ^^ 4 + b *
 * Sz ^^ 6 (mod p)` [NSA19 Section 2.2].
 */
type ProjectivePoint = { x : Z p, y : Z p, z : Z p }

/**
 * "The point at infinity, or the identity [NSA19 Section 2.2."
 */
O : ProjectivePoint
O = { x = 1, y = 1, z = 0 }

/**
 * Routine 2.2.1: Create a projective point `R` from an affine point
 * `S` [NSA19 Section 2.2].
 */
ec_projectify : AffinePoint -> ProjectivePoint
ec_projectify S = R
  where R = { x = S.x
            , y = S.y
            , z = 1
            }

/**
 * Routine 2.2.2: Create an affine point `R` from a projective point
 * `S` [NSA19 Section 2.2].
 */
ec_affinify : ProjectivePoint -> Result AffinePoint (String _)
ec_affinify S =
    if S.z == 0 then
      Err "Cannot affinify the point at infinity"
    else Ok R
  where
    lambda = recip S.z
    R = { x = lambda ^^ 2 * S.x
        , y = lambda ^^ 3 * S.y
        }

/**
 * This is a helper function to deterine whether a given point is on
 * the curve [NSA19 Section 1].
 */
pointIsOnCurve : AffinePoint -> Bool
pointIsOnCurve { x = x, y = y } =
    y ^^ 2 == x ^^ 3 - 3 * x + b 

/**
 * Routine 2.2.3: Set `Rbar` to compressed `Sbar` from an affine point
 * `S` [NSA19 Section 2.2].
 */
ec_compress : AffinePoint -> [2 + width p]
ec_compress S = Rbar
  where
    Rbar = drop (2 + (Sy % 2)) # Sx
    Sx = ZtoBV S.x : [width p]
    Sy = ZtoBV S.y : [width p]

/**
 * Routine 2.2.4: Create an affine point `R` from compressed `Sbar`
 * [NSA19 Section 2.2].
 */
ec_decompress : [2 + width p] -> Result AffinePoint (String _)
ec_decompress S = R
  where
    c  = toInteger (take S : [2])
    Rx = BVtoZ     (drop S : [width p]) : Z p
    t0 = Rx ^^ 3 - 3 * Rx + b
    t1 = mp_mod_sqrt t0
    Ry = if fromZ t1 % 2 == c % 2 then
           t1
         else
          -t1
    R  = if t1 ^^ 2 != t0 then
           Err "no such point"
         else
           Ok { x = Rx, y = Ry }

/**
 * Property demonstrating that `mp_mod_sqrt` is correct.
 *
 * ```
 * :check decompress_correct
 * ```
 */
mp_mod_sqrt_correct : Z p -> Bool
property mp_mod_sqrt_correct x =
    (mp_mod_sqrt (x ^^ 2)) ^^ 2 == (x ^^ 2)

/**
 * Routine 2.2.5: Check whether the affine point `S` is on the curve
 * [NSA19 Section 2.2].
 */
ec_is_point_affine : AffinePoint -> Bool
ec_is_point_affine S = S.y ^^ 2 == t
  where t = S.x ^^ 3 - 3 * S.x + b

/**
 * Routine 2.2.6: Set `R` to `2S` [NSA19 Section 2.2].
 */
ec_double : ProjectivePoint -> ProjectivePoint
ec_double S =
    if S.z == 0 then
      { x = 1, y = 1, z = 0 }  // 5: R <- (1, 1, 0) and return */
    else
      { x = r18, y = r23, z = r13 }
  where
    r7  = S.z ^^ 2       //  7: t4 <- t3 ^^ 2
    r8  = S.x - r7       //  8: t5 <- t1 - t4
    r9  = S.x + r7       //  9: t4 <- t1 + t4
    r10 = r9 * r8        // 10: t5 <- t4 * t5
    r11 = 3 * r10        // 11: t4 <-  3 * t5
    r12 = S.z * S.y      // 12: t3 <- t3 * t2
    r13 = 2 * r12        // 13: t3 <-  2 * t3
    r14 = S.y ^^ 2       // 14: t2 <- t2 ^^ 2
    r15 = S.x * r14      // 15: t5 <- t1 * t2
    r16 = 4 * r15        // 16: t5 <-  4 * t5
    r17 = r11 ^^ 2       // 17: t1 <- t4 ^^ 2
    r18 = r17 - 2 * r16  // 18: t1 <- t1 - 2 * t5
    r19 = r14 ^^ 2       // 19: t2 <- t2 ^^ 2
    r20 = 8 * r19        // 20: t2 <-  8 * t2
    r21 = r16 - r18      // 21: t5 <- t5 - t1
    r22 = r11 * r21      // 22: t5 <- t4 * t5
    r23 = r22 - r20      // 23: t2 <- t5 - t2

/**
 * Routine 2.2.7: Set `R` to `S + T`. Set `R` to `(0, 0, 0)` if `S ==
 * T` [NSA19 Section 2.2].
 */
ec_add : ProjectivePoint -> ProjectivePoint -> ProjectivePoint
ec_add S T =
    if r13 == 0 then
      if r14 == 0 then
        { x = 0, y = 0, z = 0 }  // 17: R <- (0, 0, 0) and return */
      else
        { x = 1, y = 1, z = 0 }  // 19: R <- (1, 1, 0) and return */
    else
      { x = r32, y = r37, z = r27 }
    where
      r4  = T.z ^^ 2       //  4: t7 <- t6 ^^ 2
      r5  = S.x * r4       //  5: t1 <- t1 * t7
      r6  = T.z * r4       //  6: t7 <- t6 * t7
      r7  = S.y * r6       //  7: t2 <- t2 * t7

      // Covers cases on lines 2-7 and 24-26.
      (t1, t2, t3) = if T.z != 1 then (r5, r7, r25) else (S.x, S.y, S.z)

      r9  = S.z ^^ 2       //  9: t7 <- t3 ^^ 2
      r10 = T.x * r9       // 10: t4 <- t4 * t7
      r11 = S.z * r9       // 11: t7 <- t3 * t7
      r12 = T.y * r11      // 12: t5 <- t5 * t7
      r13 = t1 - r10       // 13: t4 <- t1 - t4
      r14 = t2 - r12       // 14: t5 <- t2 - t5

      r22 = 2 * t1 - r13   // 22: t1 <- 2 * t1 - t4
      r23 = 2 * t2 - r14   // 23: t2 <- 2 * t2 - t5

      r25 = S.z * T.z      // 25: t3 <- t3 * t6

      r27 = t3 * r13       // 27: t3 <- t3 * t4
      r28 = r13 ^^ 2       // 28: t7 <- t4 ^^ 2
      r29 = r13 * r28      // 29: t4 <- t4 * t7
      r30 = r22 * r28      // 30: t7 <- t1 * t7
      r31 = r14 ^^ 2       // 31: t1 <- t5 ^^ 2
      r32 = r31 - r30      // 32: t1 <- t1 - t7
      r33 = r30 - 2 * r32  // 33: t7 <- t7 - 2 * t1
      r34 = r14 * r33      // 34: t5 <- t5 * t7
      r35 = r23 * r29      // 35: t4 <- t2 * t4
      r36 = r34 - r35      // 36: t2 <- t5 - t4
      r37 = r36 /. 2       // 37: t2 <- t2 / 2

/**
 * Routine 2.2.8: Set `R` to `S + T` [NSA19 Section 2.2].
 */
ec_full_add : ProjectivePoint -> ProjectivePoint -> ProjectivePoint
ec_full_add S T =
    if S.z == 0 then T  // 1-4: if Sz == 0 then R <- T, return
     | T.z == 0 then S  // 5-8: if Tz == 0 then R <- S, return
                        // 10-11: if R == (0, 0, 0) then ec_double (R, s)
     | R == {x = 0, y = 0, z = 0} then ec_double S
    else R
  where
    R = ec_add S T      //  9: ec_add (R, S, T)

/**
 * Routine 2.2.9: Set `R` to `S - T` [NSA19 Section 2.2].
 */
ec_full_sub : ProjectivePoint -> ProjectivePoint -> ProjectivePoint
ec_full_sub S T = R
  where
    U = {x = T.x, y = -T.y, z = T.z}
    R = ec_full_add S U

/**
 * Routine 2.2.10: Set `R` to `d * S` [NSA19 Section 2.2].
 *
 * ```
 * :s prover=cvc5
 * :safe ec_mult
 * ```
 */
ec_mult : Z p -> ProjectivePoint -> ProjectivePoint
ec_mult d S =
    if   d == 0 then { x = 1, y = 1, z = 0 }
     |   d == 1 then S
     | S.z == 0 then { x = 1, y = 1, z = 0 }
    else Rs!1
  where    
    S' = if S.z != 1 then ec_projectify (unwrap (ec_affinify S))
         else S  // `unwrap` is safe here because `Err` is guarded by
                 // the `S.z == 0` case above.
    h  = 3 * k
    k  = ZtoBV d : [n + 2]
    Rs = [ { x = 1, y = 1, z = 0 } ]  // Start with 1 instead of `S` to avoid
                                      // needing to find the high-bit.
       # [ if  hi && ~ki then ec_full_add RiDouble S'
            | ~hi &&  ki then ec_full_sub RiDouble S'
           else RiDouble
             where RiDouble = ec_double Ri
         | ki <- k | hi <- h | Ri <- Rs ]

/**
 * Routine 2.2.11: An auxiliary function for `ec_twin_mult` [NSA19
 * Section 2.2].
 */
F : [5] -> [5]
F t = if 18 <= t /\ t < 22 then  9
       | 14 <= t /\ t < 18 then 10
       | 22 <= t /\ t < 24 then 11
       |  4 <= t /\ t < 12 then 14
      else                      12

/**
 * Routine 2.2.12: Set `R` to `d0 * S + d1 * T` where `0 <= d0, d1 <
 * p` [NSA19 Section 2.2].
 */
ec_twin_mult : Z p -> ProjectivePoint -> Z p -> ProjectivePoint -> ProjectivePoint
ec_twin_mult d0 S d1 T = (last states).0
  where
    SpT = ec_full_add S T
    SmT = ec_full_sub S T
    e0  = ZtoBV d0 : [max 4 n]
    e1  = ZtoBV d1 : [max 4 n]
    c   = [ [ False, False ] # take e0
          , [ False, False ] # take e1
          ] : [2][6]
    states = [ (  O, c ) ] #
             [ (Rk', c')
               where
                 h0 = if c0@0 then 31 - tail c0 else tail c0
                 h1 = if c1@0 then 31 - tail c1 else tail c1
                 u0 = if h0 < F h1 then 0 else if c0@0 then -1 else 1
                 u1 = if h1 < F h0 then 0 else if c1@0 then -1 else 1
                 c' = [ [ (u0 != 0) ^ c0@1 ] # (drop`{2} c0) # [e0k]
                      , [ (u1 != 0) ^ c1@1 ] # (drop`{2} c1) # [e1k]
                      ]
                 Rk' = if (u0 == -1) && (u1 == -1) then ec_full_sub RkDouble SpT
                        | (u0 == -1) && (u1 ==  0) then ec_full_sub RkDouble S
                        | (u0 == -1) && (u1 ==  1) then ec_full_sub RkDouble SmT
                        | (u0 ==  0) && (u1 == -1) then ec_full_sub RkDouble T
                        | (u0 ==  0) && (u1 ==  1) then ec_full_add RkDouble T
                        | (u0 ==  1) && (u1 == -1) then ec_full_add RkDouble SmT
                        | (u0 ==  1) && (u1 ==  0) then ec_full_add RkDouble S
                        | (u0 ==  1) && (u1 ==  1) then ec_full_add RkDouble SpT
                       else RkDouble
                 RkDouble = ec_double Rk
             | (Rk, [c0, c1]) <- states
             | e0k <- drop`{4} e0 # (0 : [5])
             | e1k <- drop`{4} e1 # (0 : [5])
             ]
