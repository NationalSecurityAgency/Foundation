/*
 * Description: This module provides the SLH-DSA address structure ADRS and its
 * member functions [FIPS 205 Section 4.2 and Section 4.3].
 */

module algorithms::SLH_DSA::Address where

/**
 * An address is the thirty two byte structure that names the exact
 * place a hash call sits inside the scheme. Every tweakable hash takes
 * one so that no two calls share an input.
 */
type ADRS = [32][8]

/** The address type for a hash step inside a WOTS plus chain. */
WOTS_HASH  = 0 : [32]

/** The address type for the compression of a WOTS plus public key. */
WOTS_PK    = 1 : [32]

/** The address type for a node of a main Merkle tree. */
TREE       = 2 : [32]

/** The address type for a node of a FORS tree. */
FORS_TREE  = 3 : [32]

/** The address type for the compression of the FORS tree roots. */
FORS_ROOTS = 4 : [32]

/** The address type for the generation of a WOTS plus secret value. */
WOTS_PRF   = 5 : [32]

/** The address type for the generation of a FORS secret value. */
FORS_PRF   = 6 : [32]

private
  /** Split a thirty two bit word into its four bytes in big endian order. */
  word : [32] -> [4][8]
  word x = split x

/** Set the layer address to the given layer and keep the rest. */
setLayerAddress : ADRS -> [32] -> ADRS
setLayerAddress adrs l = word l # drop`{4} adrs

/** Set the tree address to the given ninety six bit tree index. */
setTreeAddress : ADRS -> [96] -> ADRS
setTreeAddress adrs t = take`{4} adrs # split t # drop`{16} adrs

/** Set the type field to the given type and clear the final twelve bytes. */
setTypeAndClear : ADRS -> [32] -> ADRS
setTypeAndClear adrs y = take`{16} adrs # word y # (zero : [12][8])

/** Set the key pair address to the given index and keep the rest. */
setKeyPairAddress : ADRS -> [32] -> ADRS
setKeyPairAddress adrs i = take`{20} adrs # word i # drop`{24} adrs

/** Read the key pair address back out of an address. */
getKeyPairAddress : ADRS -> [32]
getKeyPairAddress adrs = join (take`{4} (drop`{20} adrs))

/** Set the chain address to the given index and keep the rest. */
setChainAddress : ADRS -> [32] -> ADRS
setChainAddress adrs i = take`{24} adrs # word i # drop`{28} adrs

/**
 * Set the tree height to the given height. The tree height shares the
 * same field as the chain address.
 */
setTreeHeight : ADRS -> [32] -> ADRS
setTreeHeight = setChainAddress

/** Set the hash address to the given index and keep the rest. */
setHashAddress : ADRS -> [32] -> ADRS
setHashAddress adrs i = take`{28} adrs # word i

/**
 * Set the tree index to the given index. The tree index shares the
 * same field as the hash address.
 */
setTreeIndex : ADRS -> [32] -> ADRS
setTreeIndex = setHashAddress

/** Read the tree index back out of an address. */
getTreeIndex : ADRS -> [32]
getTreeIndex adrs = join (drop`{28} adrs)
