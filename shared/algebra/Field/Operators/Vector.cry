/*
 * Description: This module provides infix operators for common
 * vector operations.
 */

module shared::algebra::Field::Operators::Vector where

import interface shared::algebra::Field::Interface
import shared::algebra::Field::Operators::Scalar { interface Interface}

/** vector type with `size` components of type `FieldElement` */
type Vector size = [size]FieldElement

/** vector addtion; associates left */
infixl 80 |+
(|+) : {size} Vector size -> Vector size -> Vector size
(|+) = zipWith (.+)

/** vector subtraction; associates left */
infixl 80 |-
(|-) : {size} Vector size -> Vector size -> Vector size
(|-) = zipWith (.-)

/** dot product; does not associate */
infix 90 |*
(|*) : {size} fin size => Vector size -> Vector size -> FieldElement
v |* w = foldl (.+) zro (zipWith (.*) v w)
