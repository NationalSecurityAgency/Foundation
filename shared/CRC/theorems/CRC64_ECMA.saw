/*
 * This is a SAW script that guides SAW to prove the properties about
 * CRC64 ECMA.
 */

// Include common SAW utilities.
include "../../../shared/SAW/utils.saw";

// Import Cryptol specification for CRC64 ECMA.
import "../CRC64_ECMA.cry" as CRC64_ECMA;

let verify_magicCheckCorrect : TopLevel Theorem =
    proveit {{ CRC64_ECMA::magicCheckCorrect`{8} }} rme;

let verify_checkCorrect : TopLevel Theorem =
    proveit {{ CRC64_ECMA::checkCorrect }} rme;

let verify_reflectionReverse : TopLevel Theorem =
    proveit {{ CRC64_ECMA::reflectionReverse }} rme;

let verify_reflectionTests : TopLevel Theorem =
    proveit {{ CRC64_ECMA::reflectionTests }} rme;

let verify_CRCUpdateCorrect : TopLevel Theorem =
    proveit {{ CRC64_ECMA::CRCUpdateCorrect`{8, 8} }} rme;

let verify_CRCUpdateTest : TopLevel Theorem =
    proveit {{ CRC64_ECMA::CRCUpdateTest }} rme;

/*
 * Verify public properties of `shared::CRC::CRC64_ECMA`.
 */
let main : TopLevel [Theorem] = do {
  magicCheckCorrect_lemma <- verify_magicCheckCorrect;
  checkCorrect_lemma      <- verify_checkCorrect;
  reflectionReverse_lemma <- verify_reflectionReverse;
  reflectionTests_lemma   <- verify_reflectionTests;
  CRCUpdateCorrect_lemma  <- verify_CRCUpdateCorrect;
  CRCUpdateTest_lemma     <- verify_CRCUpdateTest;

  summarize_verification;

  return [ magicCheckCorrect_lemma
         , checkCorrect_lemma
         , reflectionReverse_lemma
         , reflectionTests_lemma
         , CRCUpdateCorrect_lemma
         , CRCUpdateTest_lemma
         ];
};
