/*
 * Description: This module implements the CRC8 SAE J1850 Cyclic
 * Redundancy Check (CRC) [AUTOSAR Section 7.2.1.1].
 */

module shared::CRC::CRC8_SAE_J1850 = shared::CRC::Main where

type CRCResultWidth = 8
polynomial          = [True] # 0x1D
initialValue        = 0xFF
inputDataReflected  = False
resultDataReflected = False
XORValue            = 0xFF
check               = 0x4B
magicCheck          = 0xC4
